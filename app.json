{
  "name": "KING-DYLAN-MD",
  "description": "WhatsApp Bot personnalisé par King Dylan utilisant la librairie Baileys",
  "repository": "https://github.com/wambabrayan806-source/GLOBAL-XMD",
  "stack": "container",
  "logo": "https://i.ibb.co/GQ7DnnQ9/global.jpg",
  "keywords": ["whatsapp-bot", "king-dylan", "multi-device", "bot"],
  "env": {
    "OWNER_Number": {
      "description": "Ton numéro de téléphone (Propriétaire)",
      "required": true,
      "value": "237674073940"
    },
    "BOT_NAME": {
      "description": "Le nom de ton BOT",
      "required": false,
      "value": "KING-DYLAN-MD"
    },
    "BOT_NUMBER": {
      "description": "Numéro WhatsApp pour le code de jumelage",
      "required": true,
      "value": "237674073940"
    },
    "TIME_ZONE": {
      "description": "Ton fuseau horaire (Cameroun)",
      "required": false,
      "value": "Africa/Douala"
    },
    "PREFIX": {
      "description": "Le symbole pour tes commandes (ex: .)",
      "required": true,
      "value": "."
    },
     "HKEY": {
      "description": "Ta clé API Heroku (si tu utilises Heroku)",
      "required": false,
      "value": ""
    },
     "HAPP": {
      "description": "Le nom de ton application Heroku",
      "required": false,
      "value": ""
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/DuckyTeam/heroku-buildpack-imagemagick.git"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest"
    },
    {
      "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
